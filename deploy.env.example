# Digital NP Studio Web deployment example
# Copy this to the server as an environment file, then edit domains/paths.

NP_WEB_PORT=4173
NP_WEB_DATA=/home/nynum/rerun_tiktok/data

# Chromium/TikTok browser sessions are partitioned by this scope plus the NP user/account id.
# Keep this unique for this project so live accounts never share cookies with another job.
NP_TENANT_ID=rerun_tiktok
NP_CHROME_SCOPE=rerun_tiktok

# Public customer Studio URL.
NP_USER_ORIGIN=https://app.example.com

# Private admin/backoffice URL. Admin routes and slip previews are only available on this host.
NP_ADMIN_ORIGIN=https://admin.example.com

# Force Secure cookies when running behind HTTPS.
NP_SECURE_COOKIE=1

# Keep disabled unless intentionally used during maintenance.
NP_ALLOW_WEB_SHUTDOWN=0
